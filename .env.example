# Copie para .env (não versionar) e preencha fora do repositório.
# Use Application Default Credentials (ADC) localmente; nunca chaves JSON de service account.
# Somente nomes de variáveis: não inclua valores reais neste arquivo.
# GCS_BUCKET_NAME e BQ_DATASET_* são lidas pelo código e pelo dbt.
# DBT_TARGET seleciona o perfil do dbt; o padrão é dev.
# CLOUD_LOGGING_ENABLED ativa envio explícito de logs via ADC; padrão false.

GCP_PROJECT_ID=
GCP_REGION=
GCP_LOCATION=
GCS_BUCKET_NAME=
BQ_DATASET_BRONZE=
BQ_DATASET_SILVER=
BQ_DATASET_GOLD=
BQ_DATASET_OPS=
DBT_TARGET=
PIPELINE_NAME=
LOG_LEVEL=
CLOUD_LOGGING_ENABLED=false
